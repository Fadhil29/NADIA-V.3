{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "config",
    "pages",
    "utils",
    "tests",
    "scripts",
    "reporters",
    "playwright.config.ts"
  ]
}
